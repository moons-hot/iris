XAI_API_KEY=
# Optional. Overrides GROK_VOICE_INSTRUCTIONS in src/lib/grok-voice.ts.
GROK_VOICE_INSTRUCTIONS=
# Optional. Defaults to .iris-onboard.db in the ui directory.
DATABASE_PATH=
# Tiger Cloud connection string from `tiger db connection-string --with-password`.
TIGER_DATABASE_URL=
# Optional Wi-Fi POST fallback (browser uses USB Web Serial by default).
VOICE_INGEST_URL=http://<your-computer-lan-ip>:3000/api/voice
