# Tiger Data (PostgreSQL + TimescaleDB).
# Leave unset to run the demo against the in-memory store instead.
DATABASE_URL="postgres://user:password@host:5432/tsdb?sslmode=require"

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production this belongs in a KMS/HSM, not in an env file next to the data.
IRIS_MASTER_KEY=""

# xAI / Grok. Without a key Iris falls back to deterministic intent extraction
# and template summaries, and the whole demo still works.
GROK_API_KEY=""
GROK_MODEL="grok-4-fast"
GROK_BASE_URL="https://api.x.ai/v1"
GROK_TRANSCRIBE_MODEL="grok-voice-stt"
GROK_TTS_MODEL="grok-voice-tts"
GROK_TTS_VOICE="ember"

# "grok" uses the Grok voice API through the server; "webspeech" uses the
# browser's own recognition. Falls back automatically if Grok is unavailable.
NEXT_PUBLIC_VOICE_MODE="grok"

# Set to "false" to require a real ESP32-S3 Iris Key and disable simulated keys.
IRIS_ALLOW_SIMULATED_KEY="true"

# Snowflake Cortex Search + Synthea corpus (server only).
# Leave unset to skip population retrieval; Ask Iris still answers from policy.
# Auth: programmatic access token (PAT). Mint under user Settings → Authentication.
SNOWFLAKE_ACCOUNT=""
SNOWFLAKE_USERNAME=""
SNOWFLAKE_PAT=""
# Optional. Role the PAT was minted for (often required).
SNOWFLAKE_ROLE=""
SNOWFLAKE_WAREHOUSE="IRIS_WH"
SNOWFLAKE_DATABASE="IRIS"
SNOWFLAKE_SCHEMA="SYNTHEA"
SNOWFLAKE_CORTEX_SEARCH_SERVICE="IRIS_CONTEXT_SEARCH"
# Optional. Defaults to https://<SNOWFLAKE_ACCOUNT>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_URL=""
